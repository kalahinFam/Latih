# Dependencies
node_modules/


# Build output
dist/
*.tsbuildinfo

# Serverless functions, bundled from server/ by `npm run build:api`. Vercel
# turns this directory into endpoints; the sources it is built from are the
# ones worth reading and reviewing.
/api/

# On-device inference assets (~48 MB), regenerated by `npm run setup:assets`.
# The WASM runtime is a copy of an npm dependency and the pose models are
# public downloads, so both are fully reproducible from what *is* committed.
web/public/mediapipe/
web/public/models/

# Secrets. The OpenAI key lives in the deployment environment and must never
# reach the client bundle — see the check in the README.
.env
.env.*
!.env.example

# Materi panitia — bukan karya tim, dan repo ini publik setelah deadline.
# Tidak dibutuhkan untuk membangun atau menjalankan produk.
Datathon2026-TM_Semifinal.pdf

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

