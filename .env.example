# Salin file ini menjadi `.env` di root proyek, lalu isi kuncinya.
# `.env` sudah ada di .gitignore dan tidak boleh di-commit.
#
# Kunci ini HANYA dibaca oleh serverless function di api/. Ia tidak pernah
# masuk ke bundle browser — verifikasi dengan:
#   npm run build && grep -r "sk-" web/dist/     (harus kosong)

OPENAI_API_KEY=sk-...

# Asal yang boleh memanggil endpoint berbayar (/api/coach, /api/tts,
# /api/nutrition, /api/meals). Boleh beberapa, dipisah koma — berguna kalau
# domain kustom dan URL preview Vercel dipakai bersamaan:
#   ALLOWED_ORIGIN=https://latih.app,https://latih.vercel.app
#
# Dibiarkan kosong = pemeriksaan dilewati. Itu yang diinginkan saat
# pengembangan, karena dalam satu hari aplikasi dibuka dari localhost, alamat
# LAN, dan hostname tunnel yang berganti-ganti. Di produksi, isi.
# ALLOWED_ORIGIN=

# Batas panggilan berbayar per hari, digabung dari semua endpoint dan semua
# pengguna. Batas per-klien tidak menolong kalau permintaannya tersebar dari
# banyak alamat; angka ini yang membuat tagihan punya plafon. Default 1500.
# LLM_DAILY_QUOTA=1500

# Suara pelatih. Berlaku untuk cue pra-render DAN narasi runtime, supaya yang
# terdengar sepanjang sesi adalah satu orang yang sama.
#
# Bandingkan dulu dengan telinga sendiri:
#   npm run tts:lab              # semua suara × semua gaya → folder tts-lab/
#   npm run tts:lab coral sage   # hanya dua suara
#
# Lalu isi pilihanmu di sini dan jalankan `npm run gen:cues -- --force`.
# Tanpa --force, klip cue lama tetap dipakai karena namanya di-hash dari
# frasanya, bukan dari suaranya — narasi berubah, cue tidak.
# TTS_VOICE=coral            # coral, sage, ballad, verse, ash, nova, alloy, shimmer
# TTS_STYLE=en-warm-coach    # en-warm-coach, en-brisk-corner, id-hangat
# TTS_INSTRUCTIONS=          # arahan sendiri; mengalahkan TTS_STYLE

# Pengingat jam latihan (Web Push). Bangkitkan sepasang kunci dengan:
#   node scripts/gen-vapid.mjs
# Tanpa ini, tombol pengingat di halaman Rencana otomatis disembunyikan dan
# sisa aplikasi berjalan normal. Kunci privat tidak boleh di-commit.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:kamu@contoh.com

# Penyimpanan bersama untuk dua hal: langganan pengingat dan penghitung rate
# limit. Serverless tidak punya state, jadi tanpa ini langganan hilang setiap
# kali server di-deploy ulang dan batas panggilan hanya berlaku per instance —
# cukup untuk mencoba di lokal, tidak cukup untuk produksi. Ambil dari Upstash
# Redis (tier gratis); kode memanggil REST API-nya langsung, tanpa SDK tambahan.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Diisi otomatis oleh Vercel Cron. Melindungi /api/cron-reminders supaya bukan
# tombol publik yang bisa ditekan siapa saja untuk menghabiskan kuota push.
# CRON_SECRET=

# Opsional. Tarif per satu juta token, USD — dipakai untuk menghitung biaya
# operasional yang dilaporkan di paper. Konfirmasi dulu ke halaman pricing
# provider sebelum angkanya dipublikasikan; kode tidak bisa memverifikasinya.
# LLM_PRICE_INPUT_PER_MTOK=0.15
# LLM_PRICE_OUTPUT_PER_MTOK=0.60
