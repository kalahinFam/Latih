{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:assets": "node scripts/setup-assets.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:cues": "node --experimental-strip-types scripts/gen-cues.mjs",
    "predev": "npm run setup:assets && npm run gen:cues",
    "dev": "vite --host",
    "prebuild": "npm run setup:assets && npm run gen:cues",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.0"
  }
}
