{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix web install && npm --prefix web run build && npm run build:api",
  "outputDirectory": "web/dist",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "data/tkpi/**"
    }
  }
}
