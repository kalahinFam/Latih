{
  "name": "latih",
  "private": true,
  "type": "module",
  "description": "LATIH — pelatih pribadi AI. Root package: serverless functions in server/, bundled into api/ for deployment.",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "build:api": "node scripts/build-api.mjs",
    "test": "npm --prefix web run test",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "eval:reps": "node --experimental-strip-types eval/eval_reps.mjs",
    "eval:grounding": "node --experimental-strip-types eval/eval_grounding.mjs",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "tts:lab": "node scripts/tts-lab.mjs",
    "gen:cues": "node --experimental-strip-types web/scripts/gen-cues.mjs",
    "check:tkpi": "node --experimental-strip-types scripts/check-tkpi.mjs",
    "fetch:tkpi": "node --experimental-strip-types scripts/fetch-tkpi.mjs",
    "verify:tkpi": "node --experimental-strip-types scripts/verify-tkpi.mjs"
  },
  "dependencies": {
    "openai": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.0",
    "typescript": "~6.0.2"
  }
}
